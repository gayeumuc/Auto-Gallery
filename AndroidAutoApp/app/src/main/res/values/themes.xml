<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        NoActionBar: window decor action bar'ı devre dışı bırakır.
        setSupportActionBar(toolbar) ile kendi Toolbar'ımızı kullanıyoruz.
    -->
    <style name="Theme.AutoProp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/surface_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
</resources>
