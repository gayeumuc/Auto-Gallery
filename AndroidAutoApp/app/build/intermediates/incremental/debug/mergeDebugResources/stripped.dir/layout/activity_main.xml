<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Gallery"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send an image URL to the car screen"
            android:textColor="#AAFFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <!-- URL input label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Image URL"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <!-- URL input field -->
        <EditText
            android:id="@+id/etImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com/image.jpg"
            android:textColorHint="#88FFFFFF"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="#FFFFFFFF"
            android:inputType="textUri"
            android:imeOptions="actionSend"
            android:singleLine="true"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <!-- Crop & Send button (opens crop editor) -->
        <Button
            android:id="@+id/btnCropAndSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✂ Crop &amp; Send to Car"
            android:textSize="16sp"
            android:backgroundTint="#FF2196F3"
            android:layout_marginBottom="8dp" />

        <!-- Direct send button (no crop) -->
        <Button
            android:id="@+id/btnSendUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Directly (No Crop)"
            android:textSize="14sp"
            android:backgroundTint="#FF424242"
            android:layout_marginBottom="16dp" />

        <!-- Status banner -->
        <TextView
            android:id="@+id/tvSelectedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1565C0"
            android:padding="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Image preview -->
        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:background="#FF1E1E1E"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to use:\n1. Paste an image URL above\n2. Tap ✂ Crop &amp; Send to adjust the image\n   — or — Tap Send Directly to skip cropping\n3. Open Auto Gallery on the car display\n4. Tap View Photo"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:paddingTop="8dp" />

    </LinearLayout>
</ScrollView>
